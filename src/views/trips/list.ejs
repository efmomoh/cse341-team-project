<%- include('../partials/header') %>

    <section class="trips-hero">
        <h1>
            <%= title %>
        </h1>
        <p>
            Explore scenic train journeys across the Kizuna Rail network.
            Discover routes, destinations, and the best seasons to travel.
        </p>
    </section>

    <section class="trips-catalog">

        <div id="filters">
            <label for="region-filter">Search by Region:</label>
            <select id="region-filter">
                <option value="all">All Regions</option>
            </select>

            <label for="season-filter">Search by Season:</label>
            <select id="season-filter">
                <option value="all">Any Season</option>
            </select>
        </div>

        <div class="trips-state" id="trips-loading">
            Loading trips...
        </div>

        <div class="trips-state trips-error" id="trips-error" hidden></div>

        <div class="routes-grid" id="trips-list"></div>

        <p id="trips-empty" hidden>
            No trips match your selected filters.
        </p>

        <template id="trip-card-template">
            <div class="route-card">

                <div class="route-header">
                    <h2 class="route-name" data-field="name"></h2>

                    <span class="route-region" data-field="region"></span>
                </div>

                <div class="station-info">

                    <div class="station">
                        <div class="station-type">From:</div>

                        <div class="station-name" data-field="startStation"></div>
                    </div>

                    <div class="route-arrow">&#8594;</div>

                    <div class="station">
                        <div class="station-type">To:</div>

                        <div class="station-name" data-field="endStation"></div>
                    </div>

                </div>

                <div class="route-details">

                    <div class="detail-item">
                        <span class="detail-icon">&#128337;</span>

                        <span>
                            <span class="detail-label">Duration:</span>

                            <span data-field="duration"></span>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-icon">&#128205;</span>

                        <span>
                            <span class="detail-label">Distance:</span>

                            <span data-field="distance"></span> km
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="season-badge" data-field="bestSeason"></span>
                    </div>

                </div>

                <div class="route-description" data-field="description"></div>

                <div class="highlights">
                    <div class="highlights-list" data-field="highlights"></div>
                </div>

                <div class="route-actions">
                    <a class="view-details-btn" data-field="details-link">
                        View Details &amp; Book &#8594;
                    </a>
                </div>

            </div>
        </template>

    </section>

    <script type="module" src="/js/trips.js"></script>

    <%- include('../partials/footer') %>