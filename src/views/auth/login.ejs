<!--Authenticates registered users and displays login errors-->
<%- include('../partials/header') %>

    <main class="auth-page">

        <section class="auth-card">

            <div class="auth-heading">

                <h1>Welcome back</h1>

                <p>
                    Sign in to continue your Kizuna Rail journey.
                </p>

            </div>

            <% if (query && query.registered==='true' ) { %>

                <div class="auth-success" role="status">
                    Your account was created successfully.
                    Please sign in.
                </div>

                <% } %>

                    <% if (error) { %>

                        <div class="auth-error" role="alert">
                            <%= error %>
                        </div>

                        <% } %>

                            <form class="auth-form" action="/api/auth/login" method="POST">

                                <div class="form-group">

                                    <label for="email">
                                        Email Address
                                    </label>

                                    <input type="email" id="email" name="email" placeholder="you@example.com"
                                        autocomplete="email" required>

                                </div>

                                <div class="form-group">

                                    <label for="password">
                                        Password
                                    </label>

                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your password" autocomplete="current-password" required>

                                </div>

                                <button type="submit" class="auth-button"> Sign In </button>

                            </form>

                            <p class="auth-footer"> New to Kizuna Rail? <a href="/register"> Create an account </a> </p>

        </section>

    </main>

    <%- include('../partials/footer') %>