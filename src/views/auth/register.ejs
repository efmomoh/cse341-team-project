<!--Allows new users to create accounts and displays specific registration errors-->
<%- include('../partials/header') %>

    <main class="auth-page">

        <section class="auth-card">

            <div class="auth-heading">
                <h1>Create your account</h1>
                <p>Join Kizuna Rail and start planning your next journey.</p>
            </div>

            <% if (error) { %>
                <div class="auth-error" role="alert">
                    <%= error %>
                </div>
                <% } %>

                    <form class="auth-form" action="/api/auth/register" method="POST">

                        <div class="form-group">

                            <label for="name">Full Name</label>

                            <input type="text" id="name" name="name" value="<%= formData?.name || '' %>"
                                placeholder="Enter your full name" autocomplete="name" maxlength="100" required>

                        </div>

                        <div class="form-group">

                            <label for="username">Username</label>

                            <input type="text" id="username" name="username" value="<%= formData?.username || '' %>"
                                placeholder="Choose a username" autocomplete="username" minlength="3" maxlength="30"
                                required>

                            <small> 3–30 characters. Letters, numbers, and underscores. </small>

                        </div>

                        <div class="form-group">

                            <label for="email">Email Address</label>

                            <input type="email" id="email" name="email" value="<%= formData?.email || '' %>"
                                placeholder="you@example.com" autocomplete="email" required>

                        </div>

                        <div class="form-group">

                            <label for="password">Password</label>

                            <input type="password" id="password" name="password" placeholder="Create a password"
                                autocomplete="new-password" minlength="8" required>

                            <small> Use at least 8 characters. </small>

                        </div>

                        <button type="submit" class="auth-button"> Create Account </button>

                    </form>

                    <p class="auth-footer"> Already have an account? <a href="/login">Sign in</a> </p>
        </section>
    </main>

    <%- include('../partials/footer') %>